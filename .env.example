POSTGRES_USER=smartspace
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smartspace
DATABASE_URL=postgresql+asyncpg://smartspace:change_me@localhost:5432/smartspace
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- MQTT (backend dispatcher, gateway, simulator) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=smart-space/devices

# --- device_gateway ---
GATEWAY_API_URL=http://localhost:8000
GATEWAY_API_TOKEN=            # token with role "gateway" (scripts/create_token.py)

# --- device_simulator ---
SIM_FLEET=living_room         # living_room, kitchen (comma separated)
SIM_INTERVAL=3.0
SIM_API_URL=http://localhost:8000
SIM_API_TOKEN=                # token with role admin/user: lets the simulator register its devices
